DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgres://localhost:5432/neuromed_v2
DATABASE_SSL_REQUIRE=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8003,http://localhost:8003

OPENAI_API_KEY=
# BAA must be active on this key's org before any pilot patient data reaches it — see CLAUDE.md boundary #5

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=

# --- Railway (production) ---
# 1) New Railway project → Add Postgres plugin (injects DATABASE_URL)
# 2) Set variables:
#    DEBUG=False
#    SECRET_KEY=<long random>
#    OPENAI_API_KEY=sk-...
#    ALLOWED_HOSTS=.up.railway.app,your.custom.domain
#    CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,https://your.custom.domain
#    DATABASE_SSL_REQUIRE=True
#    SECURE_SSL_REDIRECT=True
# 3) Google OAuth: add production redirect
#    https://your-app.up.railway.app/accounts/google/callback/
# 4) Deploy (Procfile / railway.toml run migrate + collectstatic)
# TRANSLATION_API_KEY=        # vendor TBD
# MEDIA_STORAGE_*             # Railway volume / S3 TBD for durable audio files
