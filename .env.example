DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgres://localhost:5432/neuromed_v2
DATABASE_SSL_REQUIRE=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8003,http://localhost:8003

OPENAI_API_KEY=
# BAA must be active on this key's org before any pilot patient data reaches it — see CLAUDE.md boundary #5

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=

# --- Railway (production) ---
# 1) New Railway project → Add Postgres plugin (injects DATABASE_URL)
# 2) Set variables:
#    DEBUG=False
#    SECRET_KEY=<long random>
#    OPENAI_API_KEY=sk-...
#    ALLOWED_HOSTS=.up.railway.app,your.custom.domain
#    CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,https://your.custom.domain
#    DATABASE_SSL_REQUIRE=True
#    SECURE_SSL_REDIRECT=True
# 3) Google OAuth: add production redirect
#    https://your-app.up.railway.app/accounts/google/callback/
# 4) Deploy: railway.toml runs migrate as a pre-deploy step and collectstatic at start.
#    DATABASE_URL must be a reference variable on this service: ${{Postgres.DATABASE_URL}}
# TRANSLATION_API_KEY=        # vendor TBD
# MEDIA_STORAGE_*             # Railway volume / S3 TBD for durable audio files

# --- Patient files (photos, PDFs shared in Ask Aira or on Documents) ---
# Every file is encrypted before it is stored; the storage provider only sees ciphertext.
# Generate once and keep a copy in your password manager (losing it = files unreadable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=
# local = encrypted files in ./private_media (dev only; Railway's disk is wiped on deploy)
# iceberg = encrypted files on cdn.katalyst-crm.com
DOCUMENT_STORAGE=local
ICEBERG_TOKEN=
# ICEBERG_API_BASE=https://dashboard.katalyst-crm.com
# ICEBERG_KEY_PREFIX=neuromed-aira/documents
